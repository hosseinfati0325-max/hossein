# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: Hosted URL
APP_URL=

# Production Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/linguapulse
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/linguapulse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=linguapulse

# Redis Cache & Broker
REDIS_URL=redis://localhost:6379/0

# JWT & Authentication Secret
SECRET_KEY=

# AI Free Mode: when true, only legitimate free tiers and free models are used
AI_FREE_MODE=true

# Multi-AI Provider API Keys (All keys are optional; if missing, provider is DISABLED)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=
CEREBRAS_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
AI_PROVIDER_PRIORITY=gemini,groq,openrouter,cerebras,huggingface,compatible,openai,anthropic

# Environment & Observability
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
